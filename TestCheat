local matrixConnection

matrixConnection = RunService.Heartbeat:Connect(function(dt)
	if not matrixRunning or not matrixFrame.Parent then
		if matrixConnection then
			matrixConnection:Disconnect()
		end
		return
	end

	for _, data in ipairs(matrixColumns) do
		local label = data.label

		if label and label.Parent then
			local y = label.Position.Y.Scale + dt * data.speed * 0.5

			if y > 1 then
				y = -1.2
			end

			label.Position = UDim2.new(
				label.Position.X.Scale,
				0,
				y,
				0
			)
		end
	end
end)

